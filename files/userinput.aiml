<aiml version="2.0">
 <!-- Invalid Input Handling with Loop -->
    <category>
        <pattern>*</pattern>
        <template>
            <think><set name="loop">true</set></think>
            It looks like I didn't understand that. Please ask about specific job roles or general career guidance. For example, you could ask "Tell me about Data Scientist" or "What jobs can I get with a computer science degree?"
            <condition name="loop" value="true">
                I'm here to help! Please clarify or ask about a specific role.
                <think><set name="loop">false</set></think>
            </condition>
        </template>
    </category>
</aiml>
