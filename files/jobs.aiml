 <aiml version="2.0">
     <!-- Specific Job Role Details -->
    <category>
        <pattern>SOFTWARE DEVELOPER</pattern>
        <template>A Software Developer designs, develops, and maintains software applications. Would you like more information or resources about this role? Type 'Software Developer Info'.</template>
    </category>

    <category>
        <pattern>DATA SCIENTIST</pattern>
        <template>A Data Scientist analyzes and interprets complex data to help organizations make data-driven decisions. Let me know if you need more details or resources! Type 'Data Scientist Info' for more resources!</template>
    </category>

    <category>
        <pattern>CYBERSECURITY ANALYST</pattern>
        <template>A Cybersecurity Analyst protects an organization's systems and networks from cyber-attacks. Ask if you need further details or resources! Type 'Cybersecurity Analyst Info' for more resources!</template>
    </category>

    <category>
        <pattern>SYSTEMS ANALYST</pattern>
        <template>A Systems Analyst evaluates and improves computer systems to meet business requirements. Type 'Systems Analyst Info' for more resources!</template>
    </category>

    <category>
        <pattern>NETWORK ENGINEER</pattern>
        <template>A Network Engineer designs, configures, and manages computer networks. Type 'Network Engineer Info' for more resources!</template>
    </category>
</aiml>